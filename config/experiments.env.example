# FGCS TR-DP-AFRL experiment configuration template
#
# Copy to config/experiments.env and review before running.
# These are example settings, NOT a verified reconstruction
# of every published experiment.
#
# Experiment-specific scripts may override these values.
# Never write new runs into results/frozen/.

# General
ROUNDS=300
SEED=42
K=5
MIN_PARTICIPANTS=3
WIN=10

# Federated training
LOCAL_EPOCHS=2
LR_LOCAL=0.0008
BATCH_SIZE=128

# Reward weights
ALPHA_ACC=1.0
BETA_LAT=0.25
GAMMA_OFF=0.10
LAMBDA_STAB=0.15

# TR-DP-AFRL parameters
TRDP_ETA=0.6
TRDP_WMIN=0.02
TRDP_WMAX=0.7
TRDP_STARVE_PEN=0.1

# Data partitioning
DIRICHLET_ALPHA=0.5

# Client execution
MAX_PARALLEL_CLIENTS=10

# E7 impairment settings
IMPAIR_CONDITION=none
IMPAIR_START_ROUND=101
IMPAIR_STOP_ROUND=201
NET_DELAY_MS=120
NET_LOSS_PCT=5.0

# E6-B controller-only scalability
E6B_SIZES="10 20 50 100"
E6B_WARMUP=100
E6B_REPETITIONS=1000

# Dataset location: set this in your local experiments.env
# to the downloaded Zenodo dataset CSV.
DATASET_CSV=""

# Local preprocessing artifacts
CLASS_MAP_PATH=""
SCALER_PATH=""

# Python interpreter, if not using python3 on PATH
PYTHON_BIN="python3"
